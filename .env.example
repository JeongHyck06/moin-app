# 이 파일을 복사해 .env.local (내 PC 에뮬레이터) 과 .env.prod (운영) 를 만든다
# 빌드는 ENVFILE 로 고르고, ENVFILE 없이 빌드하면 .env 를 읽는다
# Xcode 에서 직접 Run 할 일이 있으면 app 에서 `ln -sfn .env.local .env` 한 번 해둘 것

# 카카오 개발자 콘솔의 네이티브 앱 키, 비어 있으면 로그인 화면이 개발용 닉네임 로그인으로 동작한다
KAKAO_APP_KEY=
# 백엔드 주소, Android 에뮬레이터에서는 localhost 가 10.0.2.2 로 자동으로 바뀐다
API_BASE_URL=
